# SQLite is used automatically when DATABASE_URL is omitted.
# DATABASE_URL=mysql+pymysql://domainoss:change-me@db/domainoss

# Set an explicit secret for containers and multi-instance deployments.
SECRET_KEY=replace-with-a-long-random-value
SOURCE_URL=https://github.com/DigitalPlatDev/Domain-OSS

# Set to 1 only when the panel is served through HTTPS.
COOKIE_SECURE=0

HOST=127.0.0.1
PORT=8080
WORKERS=2

# Public URL used in account recovery and verification emails.
PUBLIC_ORIGIN=http://127.0.0.1:8080

# Optional SMTP delivery. Emails are logged when SMTP_HOST is empty.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=DigitalPlat Domain OSS <noreply@localhost>
SMTP_STARTTLS=1

# Private webhook targets are blocked by default to reduce SSRF exposure.
ALLOW_PRIVATE_WEBHOOKS=0
WEBHOOK_TIMEOUT=5
